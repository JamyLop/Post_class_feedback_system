# 小程序接口地址（Vite 构建时注入）
# 开发期：电脑本机调试
VITE_API_BASE=http://localhost:8000/api
# 真机联调：改为电脑局域网 IP（与手机同 WiFi），示例：
# VITE_API_BASE=http://192.168.1.100:8000/api
# 线上：必须为 HTTPS 且已加入微信合法域名（request 合法域名）
# VITE_API_BASE=https://api.example.com/api

# 微信小程序 AppID 需与 src/manifest.json、project.config.json 保持一致
# 当前 AppID: wx3911ca5507b002a0
# WX_APPID=wx3911ca5507b002a0
# WX_SECRET=your_secret
