# === 应用 ===
APP_NAME=课后反馈系统
APP_ENV=dev
DEBUG=true
LOG_DIR=logs
API_PREFIX=/api
SECRET_KEY=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]

# === 数据库 ===
DATABASE_URL=postgresql+psycopg://pfs:pfs@localhost:5432/pfs

# === Redis ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === MinIO / 文件存储 ===
# STORAGE_BACKEND=local | minio
STORAGE_BACKEND=local
MAX_UPLOAD_BYTES=10485760
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=pfs
MINIO_SECRET_KEY=pfs123456
MINIO_BUCKET=submissions
MINIO_SECURE=false

# === LLM (OpenAI 兼容接口) ===
# LLM_PROVIDER=mock | openai_compat
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# === OCR ===
# OCR_PROVIDER=mock | qwen
OCR_PROVIDER=mock
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_API_KEY=sk-xxx
OCR_MODEL=qwen-vl-ocr
OCR_TIMEOUT_SECONDS=60
OCR_MAX_RETRIES=1

# === 前端 ===
VITE_API_BASE=http://localhost:8000/api
