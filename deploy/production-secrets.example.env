# 仅作变量清单；真实值放在 CI/CD 或云平台 Secret Manager，切勿提交到仓库。
POSTGRES_PASSWORD=replace-in-secret-store
SECRET_KEY=generate-at-least-32-random-characters
CORS_ORIGINS=["https://your-production-domain.example"]
STORAGE_BACKEND=oss
OSS_ACCESS_KEY_ID=replace-in-secret-store
OSS_ACCESS_KEY_SECRET=replace-in-secret-store
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=xueshengyian
VITE_API_BASE=/api
UVICORN_WORKERS=2
ACCESS_TOKEN_EXPIRE_MINUTES=240
WX_APPID=replace-if-miniprogram-login-enabled
WX_SECRET=replace-in-secret-store
LLM_PROVIDER=mock
LLM_API_KEY=replace-in-secret-store-if-enabled
OCR_PROVIDER=mock
OCR_API_KEY=replace-in-secret-store-if-enabled
